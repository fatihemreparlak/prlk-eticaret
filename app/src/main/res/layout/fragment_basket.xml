<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fitsSystemWindows="true"
    tools:context=".bottomFragments.BasketFragment">

    <LinearLayout
        android:id="@+id/layout_basket_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sepetim"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:letterSpacing="-0.02" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_basket"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layout_checkout_bar"
        android:layout_below="@+id/layout_basket_header"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/txt_empty_basket_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Sepetinizde henüz ürün bulunmuyor."
        android:textColor="@color/text_muted"
        android:textSize="15sp"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_checkout_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:cardElevation="8dp"
        app:cardCornerRadius="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#EAEAEA"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toplam Tutar"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:id="@+id/txt_basket_total_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 TL"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/prlk_primary" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_checkout"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:text="Sepeti Onayla"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="@color/prlk_primary"
                android:textColor="@color/white"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>