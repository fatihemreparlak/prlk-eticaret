<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Eticaret" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fitsSystemWindows">true</item>

        <!-- Kartların ve yüzeylerin çiğ beyaz durmasını engelleyen o premium grimsi ton -->
        <item name="colorSurface">#F1F2F4</item>
        <item name="colorPrimary">@color/prlk_primary</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="Theme.Eticaret" parent="Base.Theme.Eticaret" />

    <style name="BottomNavIconStyle">
        <item name="android:maxWidth">28dp</item>
        <item name="android:maxHeight">28dp</item>
    </style>

    <style name="BottomNavLabelStyle">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="ShapeAppearance.ProductImage" parent="">
        <item name="cornerSizeTopLeft">12dp</item>
        <item name="cornerSizeTopRight">12dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

</resources>